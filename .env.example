# Copy to .env and fill in. Leave Razorpay/Shiprocket blank to run in TEST (mock) mode.
PORT=3000
NODE_ENV=development
# Public URL of the site, used in payment callbacks and emails
SITE_URL=http://localhost:3000

# Random long string; signs admin session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created on first start if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Razorpay (Dashboard > Settings > API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket API user (Settings > API > Create API user)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Any random string; set the same value as the webhook token in Shiprocket
SHIPROCKET_WEBHOOK_TOKEN=

# Email (order confirmations to customers + new-order alerts to you). Leave blank to turn emails off.
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-letter app password>
# Zoho Mail (India): SMTP_HOST=smtp.zoho.in  SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: the From address and name (default: SMTP_USER and your brand name)
MAIL_FROM=
MAIL_FROM_NAME=
# Optional: force TLS mode (true = TLS from the start, false = STARTTLS). Normally decided by the port.
SMTP_SECURE=
